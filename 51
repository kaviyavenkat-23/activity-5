import java.util.*;

class Solution {
    public List<List<String>> solveNQueens(int n) {
        List<List<String>> result = new ArrayList<>();
        
        // Track blocked columns and diagonals
        Set<Integer> cols = new HashSet<>();
        Set<Integer> posDiag = new HashSet<>(); // (row + col)
        Set<Integer> negDiag = new HashSet<>(); // (row - col)
        
        // Initialize an empty chessboard
        char[][] board = new char[n][n];
        for (int i = 0; i < n; i++) {
            Arrays.fill(board[i], '.');
        }
        
        backtrack(result, board, 0, n, cols, posDiag, negDiag);
        return result;
    }
    
    private void backtrack(List<List<String>> result, char[][] board, int row, int n,
                           Set<Integer> cols, Set<Integer> posDiag, Set<Integer> negDiag) {
        // Base case: If we successfully placed queens in all rows, save the board configuration
        if (row == n) {
            result.add(constructBoard(board));
            return;
        }
        
        // Try placing a queen in each column of the current row
        for (int col = 0; col < n; col++) {
            // Check if the position is under attack
            if (cols.contains(col) || posDiag.contains(row + col) || negDiag.contains(row - col)) {
                continue;
            }
            
            // Step 1: Make a choice
            board[row][col] = 'Q';
            cols.add(col);
            posDiag.add(row + col);
            negDiag.add(row - col);
            
            // Step 2: Recurse to the next row
            backtrack(result, board, row + 1, n, cols, posDiag, negDiag);
            
            // Step 3: Undo the choice (Backtrack)
            board[row][col] = '.';
            cols.remove(col);
            posDiag.remove(row + col);
            negDiag.remove(row - col);
        }
    }
    
    // Helper function to convert the char array into the required list of strings layout
    private List<String> constructBoard(char[][] board) {
        List<String> list = new ArrayList<>();
        for (int i = 0; i < board.length; i++) {
            list.add(new String(board[i]));
        }
        return list;
    }
}
